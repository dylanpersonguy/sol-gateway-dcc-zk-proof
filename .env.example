# =========================================================================
# SOL ⇄ DecentralChain Bridge — Environment Variables
#
# Copy this file to .env and fill in the values.
# NEVER commit the .env file with secrets!
# =========================================================================

# ---------- Solana ----------
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_WS_URL=wss://api.devnet.solana.com
SOLANA_PROGRAM_ID=9yJDb6VyjDHmQC7DLADDdLFm9wxWanXRM5x9SdZ3oVkF
# PDA derived automatically from program — set for reference only
# SOLANA_VAULT_PDA=

# ---------- DecentralChain ----------
DCC_NODE_URL=https://keough-node.decentralchain.io
DCC_BRIDGE_CONTRACT=3P_BRIDGE_CONTROLLER_ADDRESS
DCC_CHAIN_ID=63
DCC_CHAIN_ID_CHAR=?
SOL_ASSET_ID=REPLACE_WITH_SOL_ASSET_ID
# Validator's DCC seed phrase — used to sign mint transactions
# CRITICAL: Keep secret! Never commit!
DCC_VALIDATOR_SEED=replace with your 15-word DCC seed phrase

# ---------- Validator ----------
VALIDATOR_NODE_ID=validator-1
VALIDATOR_PRIVATE_KEY_PATH=./data/keys/validator.key
# Solana keypair that pays the fee on unlock (DCC -> SOL) transactions.
# A separate key from the attestation signer above, and it must hold SOL.
#   solana-keygen new -o validator/data/keys/solana-payer.json
SOLANA_PAYER_KEYPAIR_PATH=./data/keys/solana-payer.json
# Solana keypair this node signs UNLOCK attestations with. Must be registered as
# a validator on the bridge program — Solana verifies these with its Ed25519
# precompile, a different scheme and key from the DCC seed used for mints.
# Defaults to ./data/keys/validators/$VALIDATOR_NODE_ID.json
# Address Lookup Table for unlock transactions. Without it a 3-signature unlock
# is ~1395 bytes against Solana's 1232-byte limit and cannot be sent at all.
# Create with: ts-node scripts/create-unlock-lookup-table.ts --broadcast
UNLOCK_LOOKUP_TABLE=

SOLANA_ATTESTATION_KEYPAIR_PATH=
MIN_VALIDATORS=2
MAX_VALIDATORS=5
SOLANA_CONFIRMATIONS=32
# DCC key blocks to wait before releasing SOL against a burn. NG microblocks
# (~3s) do not advance height and can be rolled back, so these are key blocks at
# ~60s each: 3 => ~3 minutes. Below 2 there is no settled block on top of the
# burn's round. 10 was ~10 minutes for no additional practical safety.
DCC_CONFIRMATIONS=3
# Validators discover a burn on their own reconciliation sweeps, so their
# proposals can be a sweep interval apart. This window has to exceed that
# spread or the first proposer times out before the last one has even seen the
# burn, and an unlock can never gather its signatures.
CONSENSUS_TIMEOUT_MS=180000
REORG_PROTECTION_SLOTS=50

# ---------- Validator P2P ----------
P2P_PORT=9000
BOOTSTRAP_PEERS=
# Format: host1:port1,host2:port2

# ---------- HSM (production only) ----------
HSM_ENABLED=false
HSM_MODULE_PATH=
HSM_PIN=
HSM_SLOT=0

# ---------- API Server ----------
API_PORT=3000
ALLOWED_ORIGINS=http://localhost:5173

# ---------- Frontend ----------
VITE_SOLANA_RPC_URL=https://api.devnet.solana.com
VITE_API_URL=http://localhost:3000/api/v1

# ---------- Monitoring ----------
MONITOR_PORT=9091
SLACK_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
PAGERDUTY_ROUTING_KEY=
ALERT_WEBHOOK_URL=
MIN_ACTIVE_VALIDATORS=2

# ---------- Health / Metrics ----------
HEALTH_CHECK_PORT=8080
METRICS_PORT=9090

# ---------- Rate Limits ----------
MIN_DEPOSIT_LAMPORTS=1000000
MAX_DEPOSIT_LAMPORTS=10000000000
MAX_DAILY_OUTFLOW_LAMPORTS=50000000000
LARGE_WITHDRAWAL_THRESHOLD=50000000000
LARGE_WITHDRAWAL_DELAY_MS=3600000

# ---------- Internal service auth ----------
# Shared secret the validators present to POST /api/v1/transfer/notify-complete.
# Required — the endpoint is disabled when unset. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_API_KEY=

# ---------- Reconciliation daemon ----------
# Independently re-derives locked-vs-minted balances and alerts on drift.
# Start with: npm run reconcile -w @sol-gateway-dcc/monitoring
RECONCILE_METRICS_PORT=9096
RECONCILE_INTERVAL_MS=60000
RECONCILE_WARN_DRIFT=1000000
RECONCILE_CRITICAL_DRIFT=10000000
PAGERDUTY_SERVICE_KEY=

# Warn when a fee payer has fewer than this many transactions left.
MIN_FEE_PAYER_TXS=100

# How long a signed unlock remains valid, measured from the burn's on-chain
# timestamp. Must outlast any plausible validator outage: a burn left
# unprocessed past this window is rejected on-chain as TransferExpired and
# needs manual recovery.
UNLOCK_EXPIRY_SECONDS=86400
